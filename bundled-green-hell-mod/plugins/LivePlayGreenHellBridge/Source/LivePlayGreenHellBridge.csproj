<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>LivePlayGreenHellBridge</AssemblyName>
    <RootNamespace>LivePlayGreenHellBridge</RootNamespace>
    <Version>0.1.26</Version>
    <AssemblyVersion>0.1.26.0</AssemblyVersion>
    <FileVersion>0.1.26.0</FileVersion>
    <InformationalVersion>0.1.26</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
