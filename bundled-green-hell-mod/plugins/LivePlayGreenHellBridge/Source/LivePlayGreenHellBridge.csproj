      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule" Condition="Exists('_refs\UnityEngine.AnimationModule.dll')">
      <HintPath>_refs\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
