      <HintPath>_refs\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule" Condition="Exists('_refs\UnityEngine.PhysicsModule.dll')">
